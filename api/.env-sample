OPENAI_API_KEY=
HF_TOKEN=
# DATABASE_URL=postgresql://postgres:postgres@vectordb:5432/embeddings
DATABASE_URL=postgresql+psycopg://postgres:postgres@vectordb:5432/embeddings

# we need this because to be able to run ingest.py, we need to have access to db url, but because 
# we want to run the ingest.py on machine host, the hostname of DATABASE_URL points to service name in compose file (vectordb) and 
# these hostname only resolves inside the docker network
# so to run the ingest.py, we need localhost as hostname not vectordb
DATABASE_URL_HOST=postgresql+psycopg://postgres:postgres@localhost:5432/embeddings

USE_PAID_MODELS=false
OLLAMA_BASE_URL=http://host.docker.internal:11434